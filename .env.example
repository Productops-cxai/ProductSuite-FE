# Local / ngrok: Vite proxy keeps cookies same-origin.
VITE_API_BASE_URL=/api
# Production build (AWS): must point at the API host (see FE deploy workflow).
# VITE_API_BASE_URL=https://api.testatncri.com
# Optional hint only — must match BE SEED_SUPER_ADMIN_EMAIL when set.
# Access is enforced by the API; do not rely on this for gating.
VITE_EMAIL_LOGS_ADMIN_EMAIL=admin@suitencri.com
